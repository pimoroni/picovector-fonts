#!/usr/bin/env bash

for path in $(find google-fonts/* -maxdepth 0 -type d); do
  basepath="converted/$(basename -- $path)"
  mkdir -p $basepath
  echo "> processing directory $basepath"

  for file in $(find $path/* -maxdepth 0); do
    basename="$(basename -- $file)"
    filename="${basename%.ttf}"
    extension="${basename##*.}"

    if [ "$extension" == "ttf" ] || [ "$extension" == "otf" ]
    then
      echo "  - convert $file into .af"
      ./alright-fonts/afinate --quiet --quality medium --font $file --out $basepath/$filename.af
    else
      echo "  - copy $file"
      cp $file $basepath/$filename
    fi
  done
done

echo "> generating zip files"
mkdir -p zipped
cd converted
for dir in *; do
  echo "  - zipping $dir into $dir\_AlrightFont.zip"
  zip -r ../zipped/$dir\_AlrightFont.zip $dir
done;
cd ..
